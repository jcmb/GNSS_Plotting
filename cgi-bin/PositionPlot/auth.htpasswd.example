# Copy to auth.htpasswd (same directory) or /etc/gnss-plot/htpasswd
# and add real credentials. Never commit auth.htpasswd.
#
# Generate a line with:
#   perl cgi-bin/PositionPlot/create_htpasswd.pl username 'your-password'
#
# Disable auth on a dev machine:
#   export GNSS_AUTH_ENABLED=0
#
# Example (password is "change-me"):
# gnssplot:$6$rounds=5000$usesaltvalue12$K8mV7x0uQ3nY2pL9sR4tU6wX1zA5bC7dE0fG2hI4jK6lM8nO0pQ2rS4tU6vW8xY0zA2
